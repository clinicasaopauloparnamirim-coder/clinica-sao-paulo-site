{
  "name": "clinica-sao-paulo-site",
  "main": "./control-plane/playwright-mcp/src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PlaywrightMCP"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ControlAgent"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["WhatsAppLedger"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["GoogleOAuthStore"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WHATSAPP_LEDGER",
        "class_name": "WhatsAppLedger"
      },
      {
        "name": "MCP_OBJECT",
        "class_name": "PlaywrightMCP"
      },
      {
        "name": "CONTROL_AGENT",
        "class_name": "ControlAgent"
      },
      {
        "name": "GOOGLE_OAUTH_STORE",
        "class_name": "GoogleOAuthStore"
      }
    ]
  }
}
